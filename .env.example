# Copy to .env and fill in your own values

# Hugging Face token (only needed for speaker diarization)
# Get one at: https://huggingface.co/settings/tokens
# Then accept terms: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# VoxCPM model (default is fine)
VOXCPM_MODEL=openbmb/VoxCPM2
VOXCPM_CFG=2.0
VOXCPM_STEPS=10

# Ollama (default is fine)
OLLAMA_URL=http://localhost:11434

# UI auto-open on start (1=on, 0=off)
TACHIDUBB_OPEN_BROWSER=1

# TTS engine: firered | qwen | voxcpm | f5tts | edge-tts   (default: voxcpm)
#
# "firered" runs FireRedTTS3 on *ComfyUI's* Python: Transformers 5.3+ and the
# INT8 weights live there, while this app's venv must stay on 4.57 so the
# whisperx / pyannote stack keeps working. Nothing is installed twice.
# TACHIDUBB_TTS_ENGINE=firered
# TACHIDUBB_COMFY_ROOT=D:\ComfyUI-Easy-Install\ComfyUI   (auto-probed if unset)
# TACHIDUBB_FIRERED_REPO=FireRedTTS3-int8      # -int8 (3.3 GB) | -bf16 | fp32
# TACHIDUBB_FIRERED_VARIANT=fireredtts3_base   # base (cloning) | instruct