# Python
venv/
qwen-runtime/
qwen-tts-runtime/
qwen-*.log
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Secrets / local config
.env
.env.*
!.env.example
.claude/settings.local.json

# Runtime data
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep
outputs/qwen_compare/
nltk_data/
jobs_db/*.json
!jobs_db/.gitkeep
tachidubb.db
tachidubb.db-journal
*.sqlite
*.sqlite-journal

# User-supplied reference voices (may be private)
presets/voices/*.wav
presets/voices/*.mp3
!presets/voices/.gitkeep

# Bundled binaries
bin/ffmpeg*
bin/ffprobe*
bin/yt-dlp*

# Batch folder watcher — drop videos here to auto-dub (processed/ is runtime)
watch/*
!watch/.gitkeep

# Tooling caches
.ruff_cache/
.pytest_cache/

# Frontend build deps (the built bundle in static/dist/ IS committed)
node_modules/

# Optional MuseTalk lip-sync backend (isolated runtime + checkout, ~GBs)
musetalk-runtime/
MuseTalk/

# Installer / diagnostic logs (local machine residue)
app-install*.log
cuda-install*.log

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
